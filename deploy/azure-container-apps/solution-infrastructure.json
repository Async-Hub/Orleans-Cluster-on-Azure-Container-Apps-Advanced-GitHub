{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "12487926387972360256"
    }
  },
  "parameters": {
    "nameSuffix": {
      "type": "string",
      "defaultValue": "d1",
      "metadata": {
        "description": "A suffix for resource names uniqueness."
      }
    },
    "appNamePrefix": {
      "type": "string",
      "defaultValue": "shoppingapp1"
    },
    "semVer": {
      "type": "string",
      "defaultValue": "latest"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "executorSecurityPrincipal": {
      "type": "string"
    },
    "sqlAdministratorLogin": {
      "type": "string",
      "defaultValue": "sq"
    },
    "sqlAdministratorPassword": {
      "type": "securestring"
    },
    "acrResourceGroupName": {
      "type": "string"
    },
    "acrName": {
      "type": "string"
    },
    "acrUrl": {
      "type": "string"
    }
  },
  "variables": {
    "vnetName": "[format('vnet-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "revisionSuffix": "[format('v{0}', replace(parameters('semVer'), '.', '-'))]",
    "appiName": "[format('appi-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "logName": "[format('log-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "shoppingAppCaeName": "[format('ctapenv-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "loadTestName": "[format('lt-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "storageName": "[format('st{0}{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "sqlName": "[format('sql-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "siloHostCaName": "[format('ctap-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "sigrName": "[format('sigr-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "keyVaultName": "[format('kv-{0}-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "webUiStorageName": "[format('stwebui{0}{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "webUiStorageBlobContainerName": "web-ui-data-protection",
    "webUiCaName": "[format('ctap-{0}-ui-{1}', parameters('appNamePrefix'), parameters('nameSuffix'))]",
    "tags": {
      "Purpose": "Tuning Blazor Server"
    }
  },
  "resources": [
    {
      "type": "Microsoft.LoadTestService/loadTests",
      "apiVersion": "2024-12-01-preview",
      "name": "[variables('loadTestName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.LoadTestService/loadTests', variables('loadTestName'))]",
      "name": "[guid(variables('loadTestName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
        "principalId": "[parameters('executorSecurityPrincipal')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.LoadTestService/loadTests', variables('loadTestName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2022-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[parameters('executorSecurityPrincipal')]",
            "permissions": {
              "keys": [
                "create"
              ]
            }
          }
        ],
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(variables('keyVaultName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8e3af657-a8ff-443c-a75c-2fe8c4bcb635')]",
        "principalId": "[parameters('executorSecurityPrincipal')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/keys",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'WebUIDataProtectionKey')]",
      "properties": {
        "kty": "RSA",
        "keySize": 3072
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), 'Microsoft.Authorization/roleAssignments', guid(variables('keyVaultName')))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'add')]",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[reference(resourceId('Microsoft.App/containerApps', variables('webUiCaName')), '2022-10-01', 'full').identity.principalId]",
            "permissions": {
              "keys": [
                "get",
                "decrypt",
                "encrypt",
                "unwrapKey",
                "wrapKey",
                "verify",
                "sign"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.App/containerApps', variables('webUiCaName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2"
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('webUiStorageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2"
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/default/{1}', variables('webUiStorageName'), variables('webUiStorageBlobContainerName'))]",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('webUiStorageName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('webUiStorageName'))]",
      "name": "[guid(variables('webUiStorageName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('webUiCaName')), '2022-10-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('webUiCaName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('webUiStorageName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-07-01",
      "name": "[variables('logName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 90
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appiName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "DisableIpMasking": true,
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-05-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "ShoppingApp",
            "properties": {
              "addressPrefix": "10.0.0.0/21"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.SignalRService/signalR",
      "apiVersion": "2024-03-01",
      "name": "[variables('sigrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "capacity": 1,
        "name": "Standard_S1",
        "tier": "Standard"
      },
      "kind": "SignalR",
      "properties": {
        "features": [
          {
            "flag": "ServiceMode",
            "value": "Default"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[variables('sqlName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdministratorLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdministratorPassword')]"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlName'), 'AllowAllWindowsAzureIps')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlName'), 'ShoppingAppMain')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Basic",
        "tier": "Basic"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2022-10-01",
      "name": "[variables('shoppingAppCaeName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Consumption"
      },
      "tags": "[variables('tags')]",
      "properties": {
        "vnetConfiguration": {
          "infrastructureSubnetId": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), '2025-05-01').subnets[0].id]"
        },
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2022-10-01",
      "name": "[variables('siloHostCaName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('shoppingAppCaeName'))]",
        "configuration": {
          "activeRevisionsMode": "Multiple",
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('acrResourceGroupName')), 'Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-11-01').passwords[0].value]"
            }
          ],
          "registries": [
            {
              "server": "[parameters('acrUrl')]",
              "username": "[listCredentials(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('acrResourceGroupName')), 'Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-11-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8080
          }
        },
        "template": {
          "revisionSuffix": "[variables('revisionSuffix')]",
          "containers": [
            {
              "image": "[format('{0}/shoppingapp/silohost:{1}', parameters('acrUrl'), parameters('semVer'))]",
              "name": "silo-host",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "AZURE_SQL_CONNECTION_STRING",
                  "value": "[format('Server=tcp:{0}{1},1433;Initial Catalog={2};Persist Security Info=False;User ID={3};Password={4};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', variables('sqlName'), environment().suffixes.sqlServerHostname, 'ShoppingAppMain', parameters('sqlAdministratorLogin'), parameters('sqlAdministratorPassword'))]"
                },
                {
                  "name": "AZURE_STORAGE_CONNECTION_STRING",
                  "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', variables('storageName'), listKeys(resourceId(resourceGroup().name, 'Microsoft.Storage/storageAccounts', variables('storageName')), '2019-04-01').keys[0].value)]"
                },
                {
                  "name": "APPINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', variables('appiName')), '2020-02-02').ConnectionString]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 4,
            "rules": []
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appiName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('shoppingAppCaeName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlName'))]",
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlName'), 'ShoppingAppMain')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2022-10-01",
      "name": "[variables('webUiCaName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('shoppingAppCaeName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('acrResourceGroupName')), 'Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-11-01').passwords[0].value]"
            }
          ],
          "registries": [
            {
              "server": "[parameters('acrUrl')]",
              "username": "[listCredentials(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('acrResourceGroupName')), 'Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-11-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8080
          }
        },
        "template": {
          "revisionSuffix": "[variables('revisionSuffix')]",
          "containers": [
            {
              "image": "[format('{0}/shoppingapp/webui:{1}', parameters('acrUrl'), parameters('semVer'))]",
              "name": "web-ui",
              "resources": {
                "cpu": "[json('1')]",
                "memory": "2Gi"
              },
              "env": [
                {
                  "name": "AZURE_STORAGE_CONNECTION_STRING",
                  "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', variables('storageName'), listKeys(resourceId(resourceGroup().name, 'Microsoft.Storage/storageAccounts', variables('storageName')), '2019-04-01').keys[0].value)]"
                },
                {
                  "name": "AZURE_SIGNALR_CONNECTION_STRING",
                  "value": "[listKeys(resourceId('Microsoft.SignalRService/signalR', variables('sigrName')), '2024-03-01').primaryConnectionString]"
                },
                {
                  "name": "APPINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', variables('appiName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "AZURE_BLOB_STORAGE_FOR_WEB_UI_URI",
                  "value": "[format('{0}{1}/keys.xml', reference(resourceId('Microsoft.Storage/storageAccounts', variables('webUiStorageName')), '2025-06-01').primaryEndpoints.blob, variables('webUiStorageBlobContainerName'))]"
                },
                {
                  "name": "AZURE_KEY_VAULT_FOR_WEB_UI_URI",
                  "value": "[format('{0}keys/WebUIDataProtectionKey/', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2022-07-01').vaultUri)]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 2,
            "rules": [
              {
                "name": "http-requests",
                "http": {
                  "metadata": {
                    "concurrentRequests": "100"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appiName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('shoppingAppCaeName'))]",
        "[resourceId('Microsoft.SignalRService/signalR', variables('sigrName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('webUiStorageName'))]"
      ]
    }
  ],
  "outputs": {
    "webUiCaUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('webUiCaName')), '2022-10-01').latestRevisionFqdn]"
    }
  }
}